description: IaC / container security guardrails (Terraform, Kubernetes, Docker, CI workflows)
globs: ["**/*.tf", "**/*.tfvars", "**/Dockerfile*", "**/docker-compose*.y*ml", "**/k8s/**/*.y*ml", "**/helm/**/*.y*ml", "**/.github/workflows/*.y*ml"]
alwaysApply: false
